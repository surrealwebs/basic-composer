{
	"name": "surrealwebs/basic-composer",
	"type": "wordpress-plugin",
	"description": "Basic composer setup for project.",
	"license": "GPL-2.0-or-later",
	"keywords": [
		"WordPress",
		"Plugins"
	],
	"minimum-stability": "dev",
	"prefer-stable": true,
	"config": {
		"autoloader-suffix": "Surrealwebs_Basic_Composer",
		"process-timeout": 600,
		"preferred-install": "dist",
		"platform": {
			"php": "8.4.1"
		},
		"sort-packages": true,
		"allow-plugins": {
			"composer/installers": true,
			"dealerdirect/phpcodesniffer-composer-installer": true,
			"roots/wordpress-core-installer": true
		}
	},
	"autoload": {
		"classmap": [
			"src/"
		]
	},
	"require": {
		"php": ">=8.4.1",
		"composer/installers": "2.3.0",
		"psr/container": "2.0",
		"wp-cli/wp-cli-bundle": "2.12"
	},
	"require-dev": {
		"automattic/vipwpcs": "3.1.0",
		"dealerdirect/phpcodesniffer-composer-installer": "1.2.1",
		"phpcompatibility/php-compatibility": "9.3.5",
		"phpcompatibility/phpcompatibility-wp": "2.1.8",
		"phpunit/phpunit": "12.5.35",
		"roots/wordpress": "7.1",
		"szepeviktor/phpstan-wordpress": "2.0.4",
		"wp-cli/php-cli-tools": "~0.12.4",
		"yoast/phpunit-polyfills": "4.0.0"
	},
	"scripts": {
		"lint": [
			"@lint:plugin",
			"@lint:phpstan"
		],
		"lint:plugin": "phpcs --standard=phpcs.xml.dist",
		"lint:phpstan": "phpstan analyse -vvv --memory-limit=1G",
		"lint-fix": "phpcbf --standard=phpcs.xml.dist",
		"test": "vendor/bin/phpunit --configuration=phpunit.xml",
		"release": [
			"composer install --no-dev --prefer-dist --optimize-autoloader"
		]
	},
	"extra": {
		"wordpress-install-dir": "tests/wordpress"
	}
}
